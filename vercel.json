{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.kajamanagement.eu"
        }
      ],
      "destination": "https://kajamanagement.eu/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kajamanagement.eu"
        }
      ],
      "destination": "https://kajamanagement.eu/:path*",
      "permanent": true
    }
  ]
}
